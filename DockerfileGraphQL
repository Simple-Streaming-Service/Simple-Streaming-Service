FROM python:slim

COPY requirements.txt requirements.txt
RUN pip install -r requirements.txt
RUN pip install hypercorn

COPY app ./app
COPY graphql_boot.sh ./
COPY config.py ./
COPY graphql_asgi.py ./

RUN chmod a+x graphql_boot.sh

ENV FLASK_APP graphql_asgi.py

EXPOSE 5000
ENTRYPOINT ["./graphql_boot.sh"]